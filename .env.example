# ═══════════════════════════════════════════════════════════════════
#  THE FOUNDRY — Ghost Core v1.0 · Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyalayın ve OPENROUTER_API_KEY değerini girin.
# ═══════════════════════════════════════════════════════════════════

# ── Sunucu ─────────────────────────────────────────────────────────
PORT=4040
# Yerelde yalnızca bu makineden erişim için 127.0.0.1; Docker içinde 0.0.0.0
HOST=127.0.0.1
# Üretilen araçların telemetri pingini göndereceği ve panelde gösterilen kök adres
PUBLIC_BASE_URL=http://localhost:4040
# Boş bırakılırsa kontrol API'si jetonsuz çalışır. Doluysa panel jetonu bir kez sorar.
CONTROL_TOKEN=
LOG_LEVEL=info

# ── OpenRouter / Modeller ──────────────────────────────────────────
OPENROUTER_API_KEY=buraya_api_key_gelecek
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SCOUT_MODEL=google/gemini-2.5-flash
PROPOSER_MODEL=anthropic/claude-sonnet-5.5
CRITIC_MODEL=openai/gpt-5-mini
CODER_MODEL=anthropic/claude-sonnet-5.5
# Boş bırakılırsa PROPOSER_MODEL kullanılır
ARBITRATOR_MODEL=
# Boş bırakılırsa PROPOSER_MODEL kullanılır (Reaper genetik mutasyonu)
MUTATION_MODEL=
# Ajan tartışmalarının dili / üretilen araçların arayüz dili
OUTPUT_LANGUAGE=Turkish
TOOL_UI_LANGUAGE=English
CODER_MAX_TOKENS=12000
LLM_TIMEOUT_MS=240000
LLM_MAX_RETRIES=3

# ── Hibrit Kuyruk Motoru ───────────────────────────────────────────
# true: Redis gerektirmeyen yerleşik bellek kuyruğu. false: BullMQ + Redis
# (Redis erişilemezse sistem otomatik olarak bellek kuyruğuna düşer)
USE_IN_MEMORY_QUEUE=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Dağıtım (Docker) ───────────────────────────────────────────────
# true: Docker gerektirmeden araçları /apps/:dna_id rotasında yayınlar
# false: her araç için 128MB RAM / 0.2 CPU sınırlı nginx:alpine konteyneri açar
DRY_RUN_DOCKER=true
# Docker daemon erişilemezse dry-run moduna otomatik düş
DOCKER_FALLBACK_TO_DRY_RUN=true
# Boş = platform varsayılanı (Linux/macOS: /var/run/docker.sock, Windows: //./pipe/docker_engine)
DOCKER_SOCKET_PATH=
DOCKER_IMAGE=nginx:alpine
DOCKER_BIND_HOST=127.0.0.1
DOCKER_PUBLIC_HOST=localhost
# Ghost Core bir konteyner içinde çalışıyorsa artifacts klasörünün HOST üzerindeki yolu
# (boş bırakılırsa konteynerin kendi bağlama noktasından otomatik bulunur)
HOST_ARTIFACTS_DIR=

# ── Konsey / Evrim ────────────────────────────────────────────────
COUNCIL_APPROVAL_THRESHOLD=85
# Test için 5 dakika; üretim için 172800000 (48 saat)
DEFAULT_TTL_MS=300000
SURVIVAL_PING_THRESHOLD=5

# ── Güvenlik Sigortaları (Circuit Breakers) ───────────────────────
MAX_BUDGET_PER_DNA_USD=0.50
# Tüm sistemin toplam harcama tavanı
MAX_TOTAL_BUDGET_USD=10
MAX_SELF_HEAL_RETRIES=3
MAX_ACTIVE_CONTAINERS=10
TELEMETRY_RATE_LIMIT_PER_MINUTE=60

# ── Gözcü (Scout) ─────────────────────────────────────────────────
# 0 = yalnızca panelden manuel tetikleme. Örn. 3600000 = saatte bir otonom tarama
AUTO_SCOUT_INTERVAL_MS=0
SCOUT_MAX_SIGNALS_PER_RUN=3
SCOUT_MIN_URGENCY=60
SCOUT_HN_LIMIT=20
SCOUT_REDDIT_SUBS=webdev,programming,sysadmin,devops,productivity,freelance
# İsteğe bağlı: GitHub arama limitlerini yükseltir
GITHUB_TOKEN=
